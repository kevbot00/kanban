{
  "name": "kanban",
  "private": true,
  "workspaces": [
    "web",
    "api",
    "e2e"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -ws --if-present",
    "test:e2e": "npm run test -w e2e",
    "test:e2e:ui": "npm run test:ui -w e2e"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
